  /* ── Panel-Logik ── */
  let openPanel = null;
  function _togglePanel(name) {
    if (openPanel === name) { _closePanel(name); return; }
    if (openPanel) _closePanel(openPanel);
    const el = document.getElementById('dsn-panel-' + name);
    if (!el) return;
    el.classList.add('open');
    document.getElementById('dsn-' + name + '-btn')?.classList.add('active');
    openPanel = name;
    if (name === 'chat')    _loadChat();
    if (name === 'score')   _loadScores();
    if (name === 'notif')   _loadNotifs();
    if (name === 'account') _renderAccount();
    // Außen-Klick schließt Panel
    setTimeout(() => {
      function outside(e) {
        if (!document.getElementById('dsn-widget-root').contains(e.target)) {
          _closePanel(name);
          document.removeEventListener('click', outside);
        }
      }
      document.addEventListener('click', outside);
    }, 50);
  }
  function _closePanel(name) {
    document.getElementById('dsn-panel-' + name)?.classList.remove('open');
    document.getElementById('dsn-' + name + '-btn')?.classList.remove('active');
    if (openPanel === name) openPanel = null;
  }

  /* ── Auth ── */
  function _switchAuthTab(t) {
    ['login','reg'].forEach(x => {
      document.getElementById('dsn-tab-' + x).classList.toggle('active', x === t);
      document.getElementById('dsn-tp-' + x).classList.toggle('active', x === t);
    });
  }
  function _setBtn(id, txtId, label, loading) {
    const btn = document.getElementById(id), txt = document.getElementById(txtId);
    if (!btn || !txt) return;
    btn.disabled = loading;
    txt.innerHTML = loading ? `<span class="dsn-spin"></span>${label}` : label;
  }
  function _showMsg(id, text, type) { const el = document.getElementById(id); if (!el) return; el.textContent = text; el.className = 'dsn-msg ' + type; }
  function _hideMsg(id) { const el = document.getElementById(id); if (!el) return; el.className = 'dsn-msg'; el.textContent = ''; }

  async function _login() {
    _hideMsg('dsn-l-msg');
    const user = document.getElementById('dsn-l-user').value.trim().toLowerCase();
    const pass = document.getElementById('dsn-l-pass').value;
    if (!user || !pass) { _showMsg('dsn-l-msg', 'Bitte alle Felder ausfüllen.', 'err'); return; }
    _setBtn('dsn-l-btn', 'dsn-l-btntxt', 'SUCHE…', true);
    try {
      const { data: salt } = await _db.rpc('dsn_get_salt', { p_username: user });
      if (!salt) { _showMsg('dsn-l-msg', 'Username nicht gefunden.', 'err'); return; }
      const hash = await hashPw(pass, salt);
      const { data: u } = await _db.rpc('dsn_login', { p_username: user, p_password_hash: hash });
      if (!u) { _showMsg('dsn-l-msg', 'Falsches Passwort.', 'err'); return; }
      _currentUser = u; saveSession(u); _onLogin(u);
    } catch(e) { _showMsg('dsn-l-msg', 'Fehler: ' + e.message, 'err'); }
    finally { _setBtn('dsn-l-btn', 'dsn-l-btntxt', 'EINLOGGEN', false); }
  }

  async function _register() {
    _hideMsg('dsn-r-msg');
    const user   = document.getElementById('dsn-r-user').value.trim().toLowerCase();
    const grade  = document.getElementById('dsn-r-grade').value;
    const name   = document.getElementById('dsn-r-name').value.trim() || user;
    const school = document.getElementById('dsn-r-school').value;
    const pass   = document.getElementById('dsn-r-pass').value;
    if (!user || user.length < 3) { _showMsg('dsn-r-msg', 'Username mind. 3 Zeichen.', 'err'); return; }
    if (!grade) { _showMsg('dsn-r-msg', 'Bitte Klasse wählen.', 'err'); return; }
    if (!school) { _showMsg('dsn-r-msg', 'Bitte Schule wählen.', 'err'); return; }
    if (!pass || pass.length < 6) { _showMsg('dsn-r-msg', 'Passwort mind. 6 Zeichen.', 'err'); return; }
    _setBtn('dsn-r-btn', 'dsn-r-btntxt', 'PRÜFE…', true);
    try {
      const { data: avail } = await _db.rpc('dsn_check_username', { p_username: user });
      if (!avail) { _showMsg('dsn-r-msg', 'Username vergeben.', 'err'); return; }
      const salt = genSalt(), password_hash = await hashPw(pass, salt);
      const { error } = await _db.from('dsn_users').insert([{ username: user, real_name: name, grade, school, salt, password_hash, show_name: true }]);
      if (error) throw error;
      _showMsg('dsn-r-msg', '✓ Account erstellt! Bitte einloggen.', 'ok');
      setTimeout(() => _switchAuthTab('login'), 1500);
    } catch(e) { _showMsg('dsn-r-msg', 'Fehler: ' + e.message, 'err'); }
    finally { _setBtn('dsn-r-btn', 'dsn-r-btntxt', 'ACCOUNT ERSTELLEN', false); }
  }

  function _logout() {
    clearSession(); _currentUser = null; _onLogout();
    // Andere Tabs informieren
    localStorage.setItem('dsn_logout_signal', Date.now());
    setTimeout(() => localStorage.removeItem('dsn_logout_signal'), 100);
  }

  function _onLogin(u) {
    _currentUser = u;
    // Bar updaten
    const nameEl = document.getElementById('dsn-bar-name');
    if (nameEl) { nameEl.textContent = u.username; }
    const btn = document.getElementById('dsn-user-btn');
    if (btn) { btn.innerHTML = `<span class="dsn-dot"></span><span class="dsn-name">${_esc(u.username)}</span>`; }
    _renderAccount();
    _loadNotifs();
    _subscribeChat();
    // Callback für Spiel
    if (typeof DSN._onLoginCallback === 'function') DSN._onLoginCallback(u);
  }

  function _onLogout() {
    const btn = document.getElementById('dsn-user-btn');
    if (btn) { btn.innerHTML = `<span style="font-size:14px">👤</span><span class="dsn-name">LOGIN</span>`; }
    _renderAccount();
    if (typeof DSN._onLogoutCallback === 'function') DSN._onLogoutCallback();
  }

  function _renderAccount() {
    const u = _currentUser;
    const auth  = document.getElementById('dsn-auth-section');
    const dash  = document.getElementById('dsn-dash-section');
    if (!auth || !dash) return;
    if (u) {
      auth.style.display = 'none'; dash.style.display = 'block';
      const seit = u.created_at ? new Date(u.created_at).toLocaleDateString('de-DE') : '–';
      document.getElementById('dsn-dash-name').textContent  = getDisplay(u);
      document.getElementById('dsn-dash-user').textContent  = u.username || '–';
      document.getElementById('dsn-dash-grade').textContent = 'Klasse ' + (u.grade || '–');
      document.getElementById('dsn-dash-since').textContent = seit;
      document.getElementById('dsn-dash-sub').textContent   = `Klasse ${u.grade || '–'} · ${u.school || '–'}`;
    } else {
      auth.style.display = 'block'; dash.style.display = 'none';
    }
  }

  /* ── CHAT ── */
  let _chatSub = null;
  async function _loadChat() {
    const msgs = document.getElementById('dsn-chat-msgs');
    const gate = document.getElementById('dsn-chat-gate');
    const srow = document.getElementById('dsn-chat-send-row');
    if (gate) gate.style.display = _currentUser ? 'none' : 'block';
    if (srow) srow.style.display = _currentUser ? 'flex' : 'none';
    msgs.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Lädt…</div>';
    try {
      const { data } = await _db.from('dsn_chat_messages')
        .select('*').order('created_at', { ascending: false }).limit(40);
      _renderChatMsgs((data || []).reverse());
    } catch(e) {
      msgs.innerHTML = `<div style="text-align:center;padding:20px;font-size:11px;color:var(--dsn-muted);">Chat-Tabelle fehlt.<br>SQL-Setup ausführen.</div>`;
    }
    _subscribeChat();
  }

  function _renderChatMsgs(msgs) {
    const el = document.getElementById('dsn-chat-msgs');
    if (!el) return;
    if (!msgs.length) { el.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Noch keine Nachrichten.</div>'; return; }
    el.innerHTML = msgs.map(m => {
      const own = _currentUser && m.username === _currentUser.username;
      const t = new Date(m.created_at).toLocaleTimeString('de-DE', { hour:'2-digit', minute:'2-digit' });
      return `<div class="dsn-chat-msg${own ? ' own' : ''}">
        <div class="dsn-chat-author">${_esc(m.username)}</div>
        <div class="dsn-chat-text">${_esc(m.message)}</div>
        <div class="dsn-chat-time">${t}</div>
      </div>`;
    }).join('');
    el.scrollTop = el.scrollHeight;
  }

  function _subscribeChat() {
    if (_chatSub) return;
    try {
      _chatSub = _db.channel('dsn-chat-realtime')
        .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'dsn_chat_messages' }, payload => {
          const el = document.getElementById('dsn-chat-msgs');
          if (!el) return;
          const m = payload.new;
          const own = _currentUser && m.username === _currentUser.username;
          const t = new Date(m.created_at).toLocaleTimeString('de-DE', { hour:'2-digit', minute:'2-digit' });
          const div = document.createElement('div');
          div.className = 'dsn-chat-msg' + (own ? ' own' : '');
          div.innerHTML = `<div class="dsn-chat-author">${_esc(m.username)}</div><div class="dsn-chat-text">${_esc(m.message)}</div><div class="dsn-chat-time">${t}</div>`;
          el.appendChild(div);
          el.scrollTop = el.scrollHeight;
          // Badge updaten wenn Panel zu
          if (openPanel !== 'chat') {
            const badge = document.getElementById('dsn-chat-badge');
            if (badge) { badge.style.display = 'flex'; badge.textContent = parseInt(badge.textContent || 0) + 1; }
          }
        })
        .subscribe();
    } catch(e) { /* Realtime optional */ }
  }

  async function _sendChat() {
    if (!_currentUser) return;
    const inp = document.getElementById('dsn-chat-inp');
    const msg = (inp?.value || '').trim();
    if (!msg || msg.length < 1) return;
    inp.value = '';
    const btn = document.getElementById('dsn-chat-sendbtn');
    if (btn) btn.disabled = true;
    try {
      await _db.from('dsn_chat_messages').insert({ username: _currentUser.username, message: msg });
      // Erst nach Realtime-Event oder Fallback
      const badge = document.getElementById('dsn-chat-badge');
      if (badge) badge.style.display = 'none';
    } catch(e) { inp.value = msg; }
    if (btn) btn.disabled = false;
  }

  /* ── NOTIFICATIONS ── */
  async function _loadNotifs() {
    const body = document.getElementById('dsn-notif-body');
    if (!body) return;
    body.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Lädt…</div>';
    try {
      const { data } = await _db.from('dsn_notifications')
        .select('*').order('created_at', { ascending: false }).limit(20);
      const notifs = data || [];
      const lastSeen = parseInt(localStorage.getItem(NOTIF_KEY) || '0');
      const unread = notifs.filter(n => new Date(n.created_at).getTime() > lastSeen).length;
      const badge = document.getElementById('dsn-notif-badge');
      if (badge) { badge.style.display = unread > 0 ? 'flex' : 'none'; badge.textContent = unread; }
      if (!notifs.length) { body.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Keine Benachrichtigungen.</div>'; return; }
      body.innerHTML = notifs.map(n => {
        const isUnread = new Date(n.created_at).getTime() > lastSeen;
        const t = new Date(n.created_at).toLocaleDateString('de-DE');
        return `<div class="dsn-notif-item${isUnread ? ' unread' : ''}">
          <div class="dsn-notif-title">${_esc(n.title)}</div>
          <div class="dsn-notif-body">${_esc(n.body)}</div>
          <div class="dsn-notif-time">${t}</div>
        </div>`;
      }).join('');
      // Als gelesen markieren
      localStorage.setItem(NOTIF_KEY, Date.now());
      setTimeout(() => { if (badge) badge.style.display = 'none'; }, 500);
    } catch(e) {
      body.innerHTML = '<div style="text-align:center;padding:20px;font-size:11px;color:var(--dsn-muted);">Notifications-Tabelle fehlt. SQL-Setup ausführen.</div>';
    }
  }

  /* ── SCORES ── */
  async function _loadScores() {
    const body = document.getElementById('dsn-score-body');
    if (!body) return;
    body.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Lädt…</div>';
    try {
      // Top-10 pro Spiel
      const { data } = await _db.from('dsn_scores')
        .select('*').order('score', { ascending: false }).limit(50);
      const scores = data || [];
      if (!scores.length) { body.innerHTML = '<div style="text-align:center;padding:20px;font-size:12px;color:var(--dsn-muted);">Noch keine Scores.</div>'; return; }
      // Nach Spiel gruppieren
      const byGame = {};
      scores.forEach(s => { if (!byGame[s.game_name]) byGame[s.game_name] = []; if (byGame[s.game_name].length < 5) byGame[s.game_name].push(s); });
      let html = '';
      for (const [game, list] of Object.entries(byGame)) {
        html += `<div style="margin-bottom:14px;"><div style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--dsn-accent);margin-bottom:6px;">${_esc(game)}</div>`;
        list.forEach((s, i) => {
          const own = _currentUser && s.username === _currentUser.username;
          html += `<div class="dsn-score-row${own ? '" style="border-color:var(--dsn-accent)' : ''}">
            <div><div class="dsn-score-game">${i+1}. ${_esc(s.username)}</div><div class="dsn-score-sub">${new Date(s.created_at).toLocaleDateString('de-DE')}</div></div>
            <div class="dsn-score-val">${s.score.toLocaleString()}</div>
          </div>`;
        });
        html += '</div>';
      }
      // Eigener Score einreichen (wenn eingeloggt)
      if (_currentUser) {
        html += `<div style="border-top:1px solid var(--dsn-border);padding-top:12px;margin-top:4px;">
          <div style="font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--dsn-muted);margin-bottom:6px;">Score manuell eintragen</div>
          <div class="dsn-submit-row">
            <input class="dsn-inp" id="dsn-score-game-inp" placeholder="Spielname" style="font-size:12px;padding:6px 8px;"/>
            <input class="dsn-inp" id="dsn-score-val-inp" type="number" placeholder="Score" style="font-size:12px;padding:6px 8px;"/>
            <button class="dsn-btn" onclick="DSN.submitScore(document.getElementById('dsn-score-game-inp').value,parseInt(document.getElementById('dsn-score-val-inp').value))" style="width:auto;padding:6px 12px;font-size:11px;">➤</button>
          </div>
          <div class="dsn-msg" id="dsn-score-msg" style="margin-top:6px;"></div>
        </div>`;
      }
      body.innerHTML = html;
    } catch(e) {
      body.innerHTML = '<div style="text-align:center;padding:20px;font-size:11px;color:var(--dsn-muted);">Scores-Tabelle fehlt. SQL-Setup ausführen.</div>';
    }
  }

  /* ── Escape ── */
  function _esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  /* ── DB Referenz ── */
  let _db = null;
  let _currentUser = null;

  /* ── Storage-Event: Login/Logout auf anderen Tabs ── */
  window.addEventListener('storage', e => {
    if (e.key === SESSION_KEY) {
      const s = e.newValue ? JSON.parse(e.newValue) : null;
      _currentUser = s;
      s ? _onLogin(s) : _onLogout();
    }
    if (e.key === 'dsn_logout_signal' && e.newValue) { _currentUser = null; _onLogout(); }
    if (e.key === THEME_KEY && e.newValue) { applyTheme(e.newValue); updateThemeBtn(); }
  });

  /* ── PUBLIC API ══════════════════════════════════ */
  window.DSN = {
    /* Wird vom Spiel aufgerufen um den aktuellen Nutzer zu bekommen */
    getUser: () => _currentUser,
    getSession,

    /* Score einreichen — aufrufen wenn Spiel endet */
    submitScore: async (gameName, score) => {
      if (!_currentUser || !gameName || isNaN(score)) {
        console.warn('[DSN] submitScore: Nicht eingeloggt oder ungültige Parameter');
        return { ok: false, reason: 'not_logged_in' };
      }
      try {
        const { error } = await _db.from('dsn_scores').insert({
          username:  _currentUser.username,
          user_id:   _currentUser.id,
          game_name: gameName,
          score:     Math.round(score)
        });
        if (error) throw error;
        // Score-Panel refreshen falls offen
        if (openPanel === 'score') _loadScores();
        return { ok: true };
      } catch(e) { return { ok: false, reason: e.message }; }
    },

    /* Callbacks für das Spiel */
    onLogin:  cb => { DSN._onLoginCallback  = cb; if (_currentUser) cb(_currentUser); },
    onLogout: cb => { DSN._onLogoutCallback = cb; },

    /* Theme */
    _toggleTheme: () => { toggleTheme(); updateThemeBtn(); },

    /* Intern */
    _togglePanel, _closePanel, _login, _register, _logout,
    _sendChat, _loadChat, _loadScores, _loadNotifs,
    _switchAuthTab, _onLoginCallback: null, _onLogoutCallback: null,
    _onLogin, _onLogout,
  };

  /* ── Init ── */
  function init() {
    injectStyles();
    injectHTML();
    applyTheme(getTheme());
    updateThemeBtn();
    loadSupabase(sb => {
      _db = sb.createClient(SUPABASE_URL, SUPABASE_ANON);
      // Session aus localStorage laden
      const s = getSession();
      if (s) { _currentUser = s; _onLogin(s); }
      // Theme auch auf <html> anwenden
      applyTheme(getTheme());
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
